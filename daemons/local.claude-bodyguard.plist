<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd 模板: 安装到 /Library/LaunchDaemons;脚本在 root 所有的 /Library/Application Support/claude-switcher/ 下(用户态不可写,防提权) -->
<!-- 常驻事件驱动模式(--daemon): 结合 route -n monitor 毫秒级感知断网/重连/手机热点切网,并按 2s 周期兜底巡检 -->
<plist version="1.0"><dict>
	<key>Label</key><string>local.claude-bodyguard</string>
	<key>ProgramArguments</key><array><string>/bin/bash</string><string>/Library/Application Support/claude-switcher/claude-bodyguard.sh</string><string>--daemon</string></array>
	<key>KeepAlive</key><true/>
	<key>ThrottleInterval</key><integer>2</integer>
	<key>RunAtLoad</key><true/>
</dict></plist>
